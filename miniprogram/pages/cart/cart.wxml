<view class="checkout-page">
  <view class="delivery-tabs">
    <view class="tab {{deliveryType === 'takeout' ? 'active' : ''}}" bindtap="switchDelivery" data-type="takeout">骑手外卖</view>
    <view class="tab {{deliveryType === 'pickup' ? 'active' : ''}}" bindtap="switchDelivery" data-type="pickup">到店自提</view>
    <view class="tab {{deliveryType === 'shipping' ? 'active' : ''}}" bindtap="switchDelivery" data-type="shipping">快递邮寄</view>
  </view>

  <view class="address-box" wx:if="{{deliveryType === 'takeout' || deliveryType === 'shipping'}}" bindtap="chooseAddress">
    <view wx:if="{{!hasAddress}}" class="empty-address">
      <text class="add-icon">+</text> 添加收货地址
    </view>
    <view wx:else class="has-address">
      <view class="contact">{{address.userName}} {{address.telNumber}}</view>
      <view class="detail">{{address.provinceName}}{{address.cityName}}{{address.countyName}}{{address.detailInfo}}</view>
    </view>
  </view>

  <view class="store-box" wx:if="{{deliveryType === 'pickup'}}" bindtap="chooseStore">
    <view class="store-title">请选择自提门店 ></view>
    <view class="store-name">{{selectedStore || '获取离我最近的门店'}}</view>
  </view>

  <view class="order-items">
    <view class="item-card" wx:for="{{cartList}}" wx:key="_id">
      <image class="item-img" src="{{item.image_url}}" mode="aspectFill"></image>
      <view class="item-info">
        <view class="item-name">{{item.name}}</view>
        <view class="item-price-qty">
          <text class="price">¥{{item.price}}</text>
          <text class="qty">x {{item.quantity}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="remark-box">
    <text class="remark-label">备注</text>
    <input class="remark-input" bindinput="inputRemark" />
  </view>
</view>
<view class="checkout-bar">
   </view>
   <view class="checkout-bar">
  <view class="total-price">
    合计: <text class="price-num">¥{{totalPrice}}</text>
  </view>
  <view class="checkout-btn" bindtap="submitOrder">立即下单</view>
</view>